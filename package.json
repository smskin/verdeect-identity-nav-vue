{
    "name": "@verdeect/identity-nav-vue",
    "version": "0.4.4",
    "description": "Vue 3 integration with Verdeect Identity Service: global navigation rail, profile menu, rail state from backend props, and a public rail for landing pages without a backend",
    "license": "MIT",
    "author": "Sergey Mihaylov",
    "homepage": "https://github.com/smskin/verdeect-identity-nav-vue#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smskin/verdeect-identity-nav-vue.git"
    },
    "bugs": {
        "url": "https://github.com/smskin/verdeect-identity-nav-vue/issues"
    },
    "keywords": [
        "vue",
        "vue3",
        "verdeect",
        "identity",
        "navigation",
        "sso",
        "user-menu",
        "inertia",
        "landing"
    ],
    "type": "module",
    "exports": {
        ".": "./src/cross-service/index.ts",
        "./style.css": "./src/style.css",
        "./identity": "./src/identity/index.ts",
        "./inertia": "./src/inertia/index.ts",
        "./public": "./src/public/index.ts",
        "./playwright": "./src/playwright/index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "src",
        "scripts",
        "docs",
        "README.md"
    ],
    "scripts": {
        "check:strings": "node scripts/check-component-strings.mjs",
        "check:isolation": "node scripts/check-component-isolation.mjs",
        "types:check": "vue-tsc --noEmit",
        "test:unit": "playwright test",
        "test": "npm run check:strings && npm run check:isolation && npm run types:check && npm run test:unit"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@playwright/test": "^1.62.0",
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "@inertiajs/vue3": {
            "optional": true
        },
        "@playwright/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.13.5",
        "typescript": "^5.2.2",
        "vue": "^3.5.13",
        "vue-tsc": "^2.2.4"
    }
}
